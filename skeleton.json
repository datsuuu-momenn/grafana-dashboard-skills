{
  "uid": "central-CHANGEME",
  "title": "【中心】CHANGEME",
  "description": "Managed in Git. Do not edit in the Grafana UI — open an MR instead.",
  "tags": ["central"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(svc:http_requests_total:rate5m, service)", "refId": "var-service"},
        "definition": "label_values(svc:http_requests_total:rate5m, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CHANGEME headline number",
      "description": "The number someone checks first.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(svc:http_requests_total:rate5m{service=~\"$service\"})",
          "legendFormat": "value",
          "refId": "A"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "CHANGEME section",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CHANGEME trend",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (service) (svc:http_requests_total:rate5m{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "CHANGEME comparison",
      "description": "Cross-entity comparison. Every target needs instant: true.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value #A"},
            "properties": [
              {"id": "displayName", "value": "CHANGEME"},
              {"id": "unit", "value": "reqps"},
              {"id": "decimals", "value": 1}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "footer": {"show": false}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (service) (svc:http_requests_total:rate5m)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
